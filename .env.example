# ===========================================
# Dictator — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it contains secrets!
#
# On AWS EC2:
#   cp .env.example .env
#   nano .env        # fill in real values
#   (or use AWS Systems Manager Parameter Store for production secrets)

# ---------------------------------------------------------------------------
# MongoDB Atlas (required)
# ---------------------------------------------------------------------------
# Get from: https://cloud.mongodb.com → Clusters → Connect → Drivers
# Format:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dictator

# ---------------------------------------------------------------------------
# Redis (required — used for Celery task queue AND rate limiting)
# ---------------------------------------------------------------------------
# Local dev:      redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0        ← Docker service name is "redis"
# AWS ElastiCache: redis://<endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# JWT Authentication (required — CHANGE THIS IN PRODUCTION)
# ---------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---------------------------------------------------------------------------
# File Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ---------------------------------------------------------------------------
# ML Models — Hugging Face model IDs (downloaded on first run)
# ---------------------------------------------------------------------------
HF_MODEL_IMAGE=umm-maybe/AI-image-detector
HF_MODEL_TEXT=openai-community/roberta-base-openai-detector

# ---------------------------------------------------------------------------
# Frontend URL (used for CORS)
# ---------------------------------------------------------------------------
# Local dev:           http://localhost:3000
# AWS (public IP/DNS): http://<EC2-PUBLIC-IP>:3000  or  https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend — Next.js public env vars (prefix MUST be NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# These are baked into the frontend build at compile time.
# Local dev:           http://localhost:8000
# AWS (public IP/DNS): http://<EC2-PUBLIC-IP>:8000  or  https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Razorpay (optional — only needed for subscription payments)
# ---------------------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# SMTP Email — for OTP / 2FA emails (optional)
# ---------------------------------------------------------------------------
# Use a Gmail App Password (NOT your real password):
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM_EMAIL=yourname@gmail.com

# ---------------------------------------------------------------------------
# AWS (Phase 3 — production deployment)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=
